<HellsJanitor>
	<conditional>
		<if cond="game_version() &lt; version(1,3,1)">
			<setattribute xpath="//window[@name='mainMenu']//mainmenubutton[not(contains(@name, 'btnQuit'))]" name="force_hide">true</setattribute>
			<append xpath="//window[@name='menuBackground']">
				<texture depth="180" color="[white]" texture="@modfolder:UIAtlases/ItemIconAtlas/warning.png" name="failure" anchor_left="#cam,0,-5" anchor_bottom="#cam,0,-5" anchor_right="#cam,1,5" anchor_top="#cam,1,5"/>
			</append>
		</if>
	</conditional>	
	
	<set xpath="/windows/window[@name='menuBackground']">
		<sprite depth="0" color="[black]" globalopacitymod="0" anchor_left="#cam,0,-5" anchor_bottom="#cam,0,-5" anchor_right="#cam,1,5" anchor_top="#cam,1,5"/>
		<texture depth="1" color="[white]" globalopacitymod="0" texture="@modfolder:UIAtlases/ItemIconAtlas/background.jpg" name="bgTexture" anchor_left="#cam,0.5,-896" anchor_right="#cam,0.5,896" anchor_bottom="#cam,0.5,-504" anchor_top="#cam,0.5,504" keepsourceaspectratio="true"/>
		
		<video name="videoTexture" depth="2" anchor_left="#cam,0.5,-896" anchor_right="#cam,0.5,896" anchor_bottom="#cam,0.5,-504" anchor_top="#cam,0.5,504" uri="@modfolder:/Video/transparent" videoaspect="FitInside" loop="true" />
		<video name="videoTexture" depth="2" anchor_left="#cam,0.5,-896" anchor_right="#cam,0.5,896" anchor_bottom="#cam,0.5,-504" anchor_top="#cam,0.5,504" uri="@modfolder:/Video/transparent1" videoaspect="FitInside" loop="true" />
	</set>
	
	<set xpath="/windows/window[@name='mainMenu']">
		<texture pos="0,0" height="400" color="[white]" texture="@modfolder:UIAtlases/ItemIconAtlas/logo.png" name="gameLogo" pivot="topleft" keep_aspect_ratio="BasedOnHeight" aspect_ratio="0.608" />
		
		<grid pos="0,-450" rows="13" cell_width="400" cell_height="60" repeat_content="false" arrangement="vertical" controller="MainMenuButtons">
			<mainmenubutton name="btnPlayGame" width="400" height="50" caption_key="xuiPlayGame" nav_up="{# !is_console ? 'btnQuit' : 'btnNews' }" />
			<mainmenubutton name="btnOptions" width="400" height="50" caption_key="xuiOptions" />
			<mainmenubutton name="btnEditingTools" width="400" height="50" caption_key="xuiEditingTools" platform="!CONSOLE" />
			<mainmenubutton name="btnDlc" width="400" height="50" caption_key="xuiMMDlc" />
			<mainmenubutton name="btnCredits" width="400" height="50" caption_key="xuiCredits" />
			<mainmenubutton name="btnNews" width="400" height="50" caption_key="xuiMMNews" />
			<mainmenubutton name="btnQuit" width="400" height="50" caption_key="xuiQuit" platform="!CONSOLE" />
		</grid>
	</set>
	
	<remove xpath="//window[@name='mainMenuNews']/rect[@name='game']"/>
	<remove xpath="//window[@name='mainMenuNews']/rect[@name='featured']"/>
	
	<set xpath="/windows/window[@name='loadingScreen']">
		<fullscreencollider name="pnlBlack" color="0,0,0,255" />

		<texture depth="2" color="[white]" texture="{background_texture}" name="loading_image" anchor_left="#cam,0,0" anchor_bottom="#cam,0,0" anchor_right="#cam,1,0" anchor_top="#cam,1,0" keepsourceaspectratio="true" />

		<sprite depth="1" anchor_left="#cam,0,-100" anchor_right="#cam,1,100" anchor_bottom="#cam,0,249" anchor_top="#cam,0,350" name="backgroundMain" sprite="ui_interface_gradient_strip" color="0,0,0,255" globalopacitymod="0" type="sliced" fillcenter="true" flip="vertically" />
		
		<rect name="tips_enabled" visible="{show_tips}">
			<label name="lblTitle"    depth="6" anchor_left="#cam,0,20"   anchor_right="#cam,1,-280" anchor_bottom="#cam,0,180" anchor_top="#cam,0,240" font_size="50" color="230,26,22" justify="left" parse_actions="true" text="{title}" upper_case="true" />
		
			<label name="lblLeft"     depth="6" anchor_left="#cam,1,-200" anchor_right="#cam,1,-150"  anchor_bottom="#cam,0,180" anchor_top="#cam,0,240" font_size="30" color="[white]" pivot="center" justify="right" parse_actions="true" max_line_count="1" text=" [action:permanent:PageTipsBack]" />
			<label name="lblIndex"    depth="6" anchor_left="#cam,1,-150" anchor_right="#cam,1,-70"   anchor_bottom="#cam,0,180" anchor_top="#cam,0,240" font_size="30" color="[white]" pivot="center" justify="center" parse_actions="true" max_line_count="1" text="{index}/{count}" />
			<label name="lblRight"    depth="6" anchor_left="#cam,1,-70"  anchor_right="#cam,1,-20"   anchor_bottom="#cam,0,180" anchor_top="#cam,0,240" font_size="30" color="[white]" pivot="center" justify="left" parse_actions="true" max_line_count="1" text="[action:permanent:PageTipsForward] " />

			<label name="lblText"     depth="6" anchor_left="#cam,0,20"   anchor_right="#cam,1,-20"   anchor_bottom="#cam,0,20"  anchor_top="#cam,0,170" font_size="32" justify="left" parse_actions="true" actions_default_format="( [e61a16]###[-] )" spacing_y="5" text="{text}" />
		</rect>
	</set>
</HellsJanitor>




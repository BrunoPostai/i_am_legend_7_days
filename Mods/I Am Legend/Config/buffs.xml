<Hells_Janitor>	
	<remove xpath="//buff[@name='buffDrunkGrandpasAwesomeSauce']/effect_group//passive_effect[@name='BarteringBuying']"/>
	<remove xpath="//buff[@name='buffDrunkGrandpasAwesomeSauce']/effect_group//passive_effect[@name='BarteringSelling']"/>
	<append xpath="//buff[@name='buffDrunkGrandpasAwesomeSauce']">
		<effect_group>
			<passive_effect name="AttributeLevel" tags="attFortitude" operation="base_add" value="2"/>
			<passive_effect name="AttributeLevel" tags="attStrength" operation="base_add" value="2"/>
			<passive_effect name="AttributeLevel" tags="attPerception" operation="base_add" value="2"/>
			<passive_effect name="AttributeLevel" tags="attAgility" operation="base_add" value="2"/>
			<passive_effect name="AttributeLevel" tags="attIntellect" operation="base_add" value="2"/>
			<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffPerkAbilityUpdate"/>
			<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffPerkAbilityUpdate"/>
			<triggered_effect trigger="onSelfBuffRemove" action="AddBuff" buff="buffPerkAbilityUpdate"/>
		</effect_group>
	</append>
	
	<set xpath="//buff[@name='buffPlayerFallingDamage']/effect_group/triggered_effect//requirement[@name='PlayerItemCount']/@item_name">oldCash</set>
	
	<append xpath="/buffs">
		<buff name="buffZombieBurnTrigger" hidden="true">
			<duration value="0"/>
			<stack_type value="ignore"/>
		</buff>
		
		<buff name="buffZombieSunBurn" hidden="true">
			<damage_type value="heat"/>
			<stack_type value="effect"/>
			<duration value="0"/>
			<update_rate value=".25"/>
			<!-- Damage while exposed -->
			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_subtract" value="0.5"/>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffIsOnFire"/>
				<!-- <triggered_effect trigger="onSelfBuffStart" action="AttachParticleEffectToEntity" particle="#IAmLegend:Effect2_Shape" /> -->
				<!-- <triggered_effect trigger="onSelfBuffRemove" action="RemoveParticleEffectFromEntity" particle="Effect2_Shape" /> -->
				<!-- <triggered_effect trigger="onSelfDied" action="RemoveParticleEffectFromEntity" particle="Effect2_Shape" /> -->
			</effect_group>
		</buff>
		
		<buff name="buffNightBiomeZombie" hidden="true">
			<duration value="0"/>
			<stack_type value="ignore"/>
		</buff>

		<buff name="buffBiomeZombieDawnDeath" hidden="true">
			<damage_type value="heat"/>
			<duration value="1"/>
			<update_rate value="0.1"/>
			<stack_type value="ignore"/>

			<effect_group>
				<passive_effect name="HealthChangeOT" operation="base_subtract" value="100000"/>
			</effect_group>
		</buff>
	</append>
	
	<append xpath="/buffs/buff[@name='buffIsOnFire']/effect_group[3]/requirement[@name='!HasBuff']/@buff">,buffZombieSunBurn</append>
</Hells_Janitor>